{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentOutput",
  "description": "Contrato de saída comum para agentes de dados.",
  "type": "object",
  "properties": {
    "interaction_id": {"type": "string", "format": "uuid"},
    "agent_id": {"type": "string"},
    "decision": {"type": ["object", "string"]},
    "justification": {"type": "string"},
    "evidence": {"type": ["object", "array", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "model_version": {"type": "string"},
    "prompt_version": {"type": "string"},
    "latency_ms": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0}
  },
  "required": ["interaction_id", "agent_id", "decision", "justification", "prompt_version", "model_version"]
}
